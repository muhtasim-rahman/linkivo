              ".validate": "newData.isString() && newData.val().length <= 2048"
            },
            "type": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "theme": {
              ".validate": "newData.isString() && newData.val().length <= 9"
            },
            "frameable": {
              ".validate": "newData.val() === true"
            },
            "checkedAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "history": {
          ".read": "auth != null && auth.uid === $uid && root.child('users').child($uid).child('profile').child('status').val() !== 'deleted' && (root.child('users').child($uid).child('lockState').child('app').val() !== true || root.child('session').child($uid).child('app').val() > now) && root.child('session').child($uid).child('vault').val() > now",
          ".indexOn": [
            "ts"
          ],
          "$hid": {
            ".write": "auth != null && auth.uid === $uid && root.child('users').child($uid).child('profile').child('status').val() !== 'deleted' && (root.child('users').child($uid).child('lockState').child('app').val() !== true || root.child('session').child($uid).child('app').val() > now) && root.child('session').child($uid).child('vault').val() > now",
            ".validate": "newData.hasChildren(['lid', 'ts'])",
            "lid": {
              ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().length >= 1"
            },
            "url": {
              ".validate": "newData.isString() && newData.val().length <= 2048"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "host": {
              ".validate": "newData.isString() && newData.val().length <= 253"
            },
            "fid": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "src": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            },
            "ts": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 60000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "secure": {},
    "session": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "jobs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && root.child('users').child($uid).child('profile').child('status').val() !== 'deleted'"
      }
    },
    "deletedAccounts": {
      ".indexOn": [
        "deleteAt"
      ],
      "$uid": {
        "summary": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    }
  }
}
